generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}


model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  password        String
   
  role            String   @default("USER")  
  status          String   @default("PENDING") 
   
  tempPassword    String? 

  projects        Project[] @relation("ProjectCreator")

  memberOf        Project[] @relation("ProjectMembers") 

  modules         Module[]
  infrastructure  InfrastructureItem[]
   
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Client {
  id              String   @id @default(uuid())
  name            String
  internalCode    String   @unique
  projects        Project[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Project {
  id              String    @id @default(uuid())
  title           String
  status          String   @default("Em Andamento")
   
  infraDetails    String?  
  documentation   String?  

  clientId        String
  client          Client    @relation(fields: [clientId], references: [id])
   
  createdByUserId String?
  createdBy       User?     @relation("ProjectCreator", fields: [createdByUserId], references: [id])
   
  members         User[]    @relation("ProjectMembers") // <--- ADICIONADO
   
  modules         Module[]
  infrastructure  InfrastructureItem[] 
   
  timeline        TimelinePhase[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Module {
  id              String   @id @default(uuid())
  type            String   
  name            String
  description     String?
  techStack       String? 
  repoUrl         String? 
  installCmd      String? 
  infraDetails    String? 
  healthUrl       String?

  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
   
  createdByUserId String?
  createdBy       User?     @relation(fields: [createdByUserId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model InfrastructureItem {
  id              String   @id @default(uuid())
   
  category        String   
  name            String  
  value           String  
   
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdBy       User?     @relation(fields: [createdByUserId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TimelinePhase {
  id             String   @id @default(uuid())
   
  name           String   
  status         String   @default("Pendente") 
  startDate      DateTime?
  endDate        DateTime?
   
  estimatedHours Int?     @default(0)
   
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Server {
  id          String   @id @default(uuid())
  name        String   // Nome do Servidor
  ipAddress   String   // IP ou Link
  username    String   // Login
  password    String   // Senha do servidor
  notes       String?  // Observação

  environments ServerEnvironment[] // Relação com os ambientes

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ServerEnvironment {
  id             String   @id @default(uuid())
  name           String   // Nome do ambiente (Ex: Homologação, Produção)
  
  accessType     String   // Varchar: Anydesk, TeamViewer, SSH, VPN, etc.
  accessId       String   // ID de conexão
  accessPassword String?  // Senha do ambiente
  hasFixedIp     Boolean  @default(false) // Se usa IP fixo
  notes          String?  // Observação
  
  serverId       String
  server         Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}