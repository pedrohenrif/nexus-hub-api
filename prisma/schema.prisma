generator client {
  provider = "prisma-client-js"
}

// Configuração do banco de dados (usando SQLite no .env por padrão)
datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}


model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  password        String
  
  role            String   @default("USER")  
  status          String   @default("PENDING") 
  
  tempPassword    String? 

  projects        Project[]
  modules         Module[]
  infrastructure  InfrastructureItem[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Client {
  id              String   @id @default(uuid())
  name            String
  internalCode    String   @unique
  projects        Project[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Project {
  id              String    @id @default(uuid())
  title           String
  status          String   @default("Em Andamento")
  
  infraDetails    String? 

  documentation   String?

  clientId        String
  client          Client    @relation(fields: [clientId], references: [id])
  
  createdByUserId String?
  createdBy       User?     @relation(fields: [createdByUserId], references: [id])
  
  modules         Module[]
  infrastructure  InfrastructureItem[] 
  
  timeline        TimelinePhase[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Module {
  id              String   @id @default(uuid())
  type            String   
  name            String
  description     String?
  techStack       String? 
  repoUrl         String? 
  installCmd      String? 
  infraDetails    String? 

  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdByUserId String?
  createdBy       User?     @relation(fields: [createdByUserId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model InfrastructureItem {
  id              String   @id @default(uuid())
  
  category        String   // Ex: 'Server', 'Database', 'Security', 'Network'
  name            String   // Ex: 'Servidor de Prod', 'AWS RDS'
  value           String   // Ex: '192.168.0.1', 'Link do painel', 'String de conexão'
  
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdBy       User?     @relation(fields: [createdByUserId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TimelinePhase {
  id             String   @id @default(uuid())
  
  name           String   
  status         String   @default("Pendente") 
  startDate      DateTime?
  endDate        DateTime?
  
  // NOVO CAMPO: Horas estimadas para esta fase
  estimatedHours Int?     @default(0)
  
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}